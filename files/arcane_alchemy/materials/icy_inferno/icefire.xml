<Entity name="$projectile_default">

	<GameEffectComponent
		effect="CUSTOM"
		custom_effect_id="AA_ICEFIRE"
		frames="50"
	/>

	<GameAreaEffectComponent
		radius="300"
		frame_length="30"
	/>

	<Base file="mods/Hydroxide/files/lib/base_field.xml">
		<LifetimeComponent lifetime="30"/>
		<SpriteComponent image_file=""/>
	</Base>

	<MagicConvertMaterialComponent
		kill_when_finished="0"
		from_material="fire"
		steps_per_frame="5"
		to_material="blood_cold_vapour"
		is_circle="1"
		radius="300" >
	</MagicConvertMaterialComponent>

	<MagicConvertMaterialComponent
		kill_when_finished="0"
		from_material="smoke"
		steps_per_frame="5"
		to_material="blood_cold_vapour"
		is_circle="1"
		radius="300"
	/>

	<VariableStorageComponent
		name="projectile_file"
		value_string="data/entities/projectiles/freeze_circle.xml"
	/>

</Entity>
